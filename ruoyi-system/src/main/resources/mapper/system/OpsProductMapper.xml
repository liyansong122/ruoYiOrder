<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.OpsProductMapper">

	<resultMap type="OpsProduct" id="OpsProductResult">
		<id     property="productId"     column="product_id"    />
		<result property="productCode"   column="product_code"  />
		<result property="productName"   column="product_name"  />
		<result property="stock"         column="stock"         />
		<result property="status"        column="status"        />
		<result property="createBy"      column="create_by"     />
		<result property="createTime"    column="create_time"   />
		<result property="updateBy"      column="update_by"     />
		<result property="updateTime"    column="update_time"   />
		<result property="remark"        column="remark"        />
	</resultMap>

	<sql id="selectOpsProductVo">
		select product_id, product_code, product_name, stock, status, create_by, create_time, update_by, update_time, remark
		from ops_product
	</sql>

	<select id="selectOpsProductList" parameterType="OpsProduct" resultMap="OpsProductResult">
		<include refid="selectOpsProductVo"/>
		<where>
			<if test="productCode != null and productCode != ''">
				AND product_code like concat('%', #{productCode}, '%')
			</if>
			<if test="productName != null and productName != ''">
				AND product_name like concat('%', #{productName}, '%')
			</if>
			<if test="status != null and status != ''">
				AND status = #{status}
			</if>
		</where>
	</select>

	<select id="selectOpsProductById" parameterType="Long" resultMap="OpsProductResult">
		<include refid="selectOpsProductVo"/>
		where product_id = #{productId}
	</select>

	<select id="checkProductCodeUnique" parameterType="String" resultMap="OpsProductResult">
		<include refid="selectOpsProductVo"/>
		where product_code = #{productCode} limit 1
	</select>

	<select id="selectOpsProductByProductName" parameterType="String" resultMap="OpsProductResult">
		<include refid="selectOpsProductVo"/>
		where product_name = #{productName} limit 1
	</select>

	<delete id="deleteOpsProductByIds" parameterType="Long">
		delete from ops_product where product_id in
		<foreach collection="array" item="productId" open="(" separator="," close=")">
			#{productId}
		</foreach>
	</delete>

	<update id="updateOpsProduct" parameterType="OpsProduct">
		update ops_product
		<set>
			<if test="productCode != null and productCode != ''">product_code = #{productCode},</if>
			<if test="productName != null and productName != ''">product_name = #{productName},</if>
			<if test="stock != null">stock = #{stock},</if>
			<if test="status != null and status != ''">status = #{status},</if>
			<if test="remark != null">remark = #{remark},</if>
			<if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
			update_time = sysdate()
		</set>
		where product_id = #{productId}
	</update>

	<insert id="insertOpsProduct" parameterType="OpsProduct" useGeneratedKeys="true" keyProperty="productId">
		insert into ops_product(
			<if test="productCode != null and productCode != ''">product_code,</if>
			<if test="productName != null and productName != ''">product_name,</if>
			<if test="stock != null">stock,</if>
			<if test="status != null and status != ''">status,</if>
			<if test="remark != null and remark != ''">remark,</if>
			<if test="createBy != null and createBy != ''">create_by,</if>
			create_time
		)values(
			<if test="productCode != null and productCode != ''">#{productCode},</if>
			<if test="productName != null and productName != ''">#{productName},</if>
			<if test="stock != null">#{stock},</if>
			<if test="status != null and status != ''">#{status},</if>
			<if test="remark != null and remark != ''">#{remark},</if>
			<if test="createBy != null and createBy != ''">#{createBy},</if>
			sysdate()
		)
	</insert>
</mapper>
